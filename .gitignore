# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.prod.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data
/server/data/music-config.json
/docker/remark42/
/.secret-backup/
# offline packaging artifacts
/dist/

# local temp artifacts
/.pwtmp/
/test-results/

# local database backup artifacts
/docker/mysql/backup/*
!/docker/mysql/backup/.gitkeep
