# 前端 Next.js 运行镜像 (多阶段构建)
FROM node:20-alpine AS builder

WORKDIR /app

# 复制依赖文件
COPY package.json package-lock.json* yarn.lock* ./

# 安装依赖
RUN npm ci

# 复制源码
COPY . .

# Build-time env for Next.js (especially NEXT_PUBLIC_* client vars)
ARG API_URL=http://localhost:6060
ARG INTERNAL_API_URL=http://localhost:6060
ARG NEXT_PUBLIC_REMARK42_URL=http://localhost:8080
ARG NEXT_PUBLIC_REMARK42_SITE_ID=sakurairo
ARG NEXT_PUBLIC_GITHUB_CLIENT_ID=
ARG NEXT_PUBLIC_GITHUB_REDIRECT_URI=

# 设置环境变量
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV API_URL=$API_URL
ENV INTERNAL_API_URL=$INTERNAL_API_URL
ENV NEXT_PUBLIC_REMARK42_URL=$NEXT_PUBLIC_REMARK42_URL
ENV NEXT_PUBLIC_REMARK42_SITE_ID=$NEXT_PUBLIC_REMARK42_SITE_ID
ENV NEXT_PUBLIC_GITHUB_CLIENT_ID=$NEXT_PUBLIC_GITHUB_CLIENT_ID
ENV NEXT_PUBLIC_GITHUB_REDIRECT_URI=$NEXT_PUBLIC_GITHUB_REDIRECT_URI

# 构建应用
RUN npm run build

# 运行阶段
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# 创建非 root 用户
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# 复制构建产物
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# 设置权限
USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
