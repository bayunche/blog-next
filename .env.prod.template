# ============================================
# Sakurairo Production Environment Template
# 用法：cp .env.prod.template .env.prod 后按实际值填写
# ============================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=sakurairo_blog
MYSQL_USER=sakurairo
MYSQL_PASSWORD=change_me_app_password

# --- JWT ---
TOKEN_SECRET=change_me_to_long_random_secret

# --- GitHub OAuth (Backend / Admin) ---
GITHUB_CLIENT_ID_PROD=your_prod_github_client_id
GITHUB_CLIENT_SECRET_PROD=your_prod_github_client_secret
ADMIN_GITHUB_LOGIN_NAME_PROD=your_github_login

# --- GitHub OAuth (Frontend / Public) ---
NEXT_PUBLIC_GITHUB_CLIENT_ID_PROD=your_prod_github_client_id
NEXT_PUBLIC_GITHUB_REDIRECT_URI_PROD=https://your-domain.com/api/conn/github/callback

# --- GitHub OAuth (Backend callback) ---
GITHUB_REDIRECT_URI_PROD=https://your-domain.com/api/conn/github/callback

# --- Remark42 ---
REMARK42_SITE_ID=sakurairo
NEXT_PUBLIC_REMARK42_SITE_ID=sakurairo
REMARK42_SECRET=change_me_remark42_secret
REMARK42_URL_PROD=https://comments.your-domain.com
NEXT_PUBLIC_REMARK42_URL=https://comments.your-domain.com
REMARK42_ORIGIN_PROD=https://your-domain.com
REMARK42_GITHUB_CLIENT_ID_PROD=your_remark42_github_client_id
REMARK42_GITHUB_CLIENT_SECRET_PROD=your_remark42_github_client_secret

# --- Email (optional) ---
EMAIL_NOTICE_ENABLE=false
EMAIL_NOTICE_HOST=smtp.qq.com
EMAIL_NOTICE_PORT=465
EMAIL_NOTICE_USER=
EMAIL_NOTICE_PASS=

# --- Image bed (optional) ---
IMAGE_BED_TYPE=chevereto
CHEVERETO_URL=
CHEVERETO_API_KEY=
